generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                String             @id @default(uuid())
  name              String
  type              String             @default("individual")
  contactEmail      String?
  contactPhone      String?
  logoUrl           String?
  bankDetails       Json?
  tokenBalance      Float              @default(0)
  settings          Json?              @default("{}")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  clients           Client[]
  decorations       Decoration[]
  expenses          Expense[]
  inventoryHistory  InventoryHistory[]
  inventory         InventoryItem[]
  invoices          Invoice[]
  openingStocks     OpeningStock[]
  orders            Order[]
  packaging         Packaging[]
  purchases         Purchase[]
  recipes           Recipe[]
  tokenTransactions TokenTransaction[]
  transactions      Transaction[]
  users             User[]
  accounts          Account[]
  journalEntries    JournalEntry[]
  journalLines      JournalLine[]
  bankAccounts      BankAccount[]
  fixedAssets       FixedAsset[]
  prepaymentSchedules PrepaymentSchedule[]
  bankStatementLines BankStatementLine[]
  accountingPeriods AccountingPeriod[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  email        String   @unique
  passwordHash String
  role                 String    @default("customer_service")
  pin                  String?
  isActivated          Boolean   @default(true)
  activationToken      String?
  activationExpiresAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Client {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  phone         String?
  email         String?
  address       String?
  birthday      String?
  lastOrderDate DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@index([tenantId])
}

model InventoryItem {
  id                String             @id @default(uuid())
  tenantId          String
  name              String
  category          String
  unit              String
  cost              Float
  stock             Float              @default(0)
  minStock          Float              @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  totalValueOnHand  Float              @default(0)
  inventoryHistory  InventoryHistory[]
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openingStocks     OpeningStock[]
  purchases         Purchase[]
  recipeIngredients RecipeIngredient[]

  @@index([tenantId])
}

model Recipe {
  id          String             @id @default(uuid())
  tenantId    String
  name        String
  notes       String?
  type        String             @default("layer")
  batchWeight     Float?
  batchSize       Float?
  application     String?            @default("spread")
  fillRate        Float?             @map("fill_rate")
  crumbRate       Float?             @default(0) @map("crumb_rate")
  coverRate       Float?             @map("cover_rate")
  sheetOverhangIn Float?             @map("sheet_overhang_in")
  isCalibrated    Boolean            @default(false) @map("is_calibrated")
  calShape        String?            @map("cal_shape")
  calDimA         Float?             @map("cal_dim_a")
  calDimB         Float?             @map("cal_dim_b")
  calGrams        Float?             @map("cal_grams")
  calHeightIn     Float?             @map("cal_height_in")
  trimPct         Float?             @default(0.08) @map("trim_pct")
  density         Float?
  canFill         Boolean?           @default(true) @map("can_fill")
  canCrumb        Boolean?           @default(true) @map("can_crumb")
  canFinish       Boolean?           @default(true) @map("can_finish")
  thickFillMm     Float?             @map("thick_fill_mm")
  thickCrumbMm    Float?             @map("thick_crumb_mm")
  thickFinishMm   Float?             @map("thick_finish_mm")
  densityGPerCm3  Float?             @map("density_g_cm3")
  wastePct        Float?             @map("waste_pct")
  sellMode        String?            @map("sell_mode")
  perBatch        Float?             @map("per_batch")
  breakagePct     Float?             @map("breakage_pct")
  createdAt       DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  orderItems  OrderItem[]
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  @@index([tenantId])
}

model RecipeIngredient {
  id              String        @id @default(uuid())
  recipeId        String
  inventoryItemId String
  quantity        Float
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  recipe          Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([inventoryItemId])
}

model Order {
  id                  String         @id @default(uuid())
  tenantId            String
  clientId            String?
  status              String         @default("quote")
  orderDate           DateTime       @default(now())
  dueDate             DateTime?
  totalPrice          Float          @default(0)
  totalCost           Float          @default(0)
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  ingredientsDeducted Boolean        @default(false)
  isBaked             Boolean        @default(false)
  bakedAt             DateTime?
  deliveredAt         DateTime?
  isForfeited         Boolean        @default(false)
  forfeitedAt         DateTime?
  metadata            Json?          @default("{}")
  invoices            Invoice[]
  client              Client?        @relation(fields: [clientId], references: [id])
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items               OrderItem[]
  payments            OrderPayment[]

  @@index([tenantId])
  @@index([clientId])
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  recipeId     String?
  name         String
  size         String?
  shape        String?
  layers       Int?
  decorations  Json?
  flavorExtras Json?
  price        Float   @default(0)
  cost         Float   @default(0)
  delivered    Boolean @default(false)
  deliveredAt  DateTime?
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recipe       Recipe? @relation(fields: [recipeId], references: [id])

  @@index([orderId])
  @@index([recipeId])
}

model OrderPayment {
  id      String   @id @default(uuid())
  orderId String
  amount  Float
  date    DateTime @default(now())
  method  String?
  type    String   @default("full")
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Transaction {
  id          String   @id @default(uuid())
  tenantId    String
  date        DateTime @default(now())
  description String
  amount      Float
  type        String
  category    String?
  reference   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Expense {
  id          String   @id @default(uuid())
  tenantId    String
  date        DateTime @default(now())
  amount      Float
  category    String
  description String?
  receiptUrl  String?
  accountCode String?
  journalEntryId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Invoice {
  id            String    @id @default(uuid())
  tenantId      String
  orderId       String
  invoiceNumber String
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  status        String    @default("draft")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
}

model Packaging {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  price     Float
  stock     Float    @default(0)
  minStock  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Decoration {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  price     Float
  stock     Float    @default(0)
  minStock  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Purchase {
  id            String         @id @default(uuid())
  tenantId      String
  date          DateTime       @default(now())
  supplier      String?
  amount        Float
  receiptUrl    String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  itemId        String?
  unitSize      Float?
  qty           Float?
  price         Float?
  total         Float?
  cpu           Float?
  stockAdded    Float?
  destination   String?        @default("inventory") // inventory, expense, fixed_asset
  journalEntryId String?
  fixedAssetId  String?
  inventoryItem InventoryItem? @relation(fields: [itemId], references: [id])
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model InventoryHistory {
  id              String        @id @default(uuid())
  tenantId        String
  inventoryItemId String
  type            String
  date            DateTime      @default(now())
  qtyDelta        Float
  valueDelta      Float
  pricePerUnit    Float
  qtyAfter        Float
  valueAfter      Float
  avgCostAfter    Float
  reason          String?
  note            String?
  referenceId     String?
  createdAt       DateTime      @default(now())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([inventoryItemId])
}

model TokenTransaction {
  id          String   @id @default(uuid())
  tenantId    String
  amount      Float
  type        String
  description String
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model OpeningStock {
  id          String         @id @default(uuid())
  tenantId    String
  itemId      String?
  name        String
  unit        String         @default("kg")
  cost        Float          @default(0)
  openingQty  Float          @default(0)
  totalValue  Float          @default(0)
  month       String?
  locked      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item        InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([itemId])
  @@index([month])
}

model Payment {
  id                String              @id @default(uuid())
  tenantId          String?
  userId            String?
  resourceType      String              // subscription_plan, credit_pack, order_deposit
  resourceId        String?             // standard, studio, pack_small, etc.
  idempotencyKey    String              @unique
  paymentReference  String              @unique
  provider          String              @default("paystack")
  providerReference String?
  providerStatus    String?
  amount            Int                 // integer minor units (kobo, e.g. 500000 = 5000 NGN)
  currency          String              @default("NGN")
  fees              Int                 @default(0)
  totalAmount       Int                 // integer minor units
  status            String              @default("PENDING") // PENDING, INITIALIZED, PROCESSING, SUCCESS, FAILED, CANCELLED, ABANDONED, EXPIRED, REFUND_PENDING, PARTIALLY_REFUNDED, REFUNDED
  customerEmail     String
  customerName      String?
  metadata          Json?               @default("{}")
  refundedAmount    Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  attempts          PaymentAttempt[]
  refunds           PaymentRefund[]
  auditEvents       PaymentAuditEvent[]

  @@index([tenantId])
  @@index([status])
  @@index([providerReference])
}

model PaymentAttempt {
  id                String    @id @default(uuid())
  paymentId         String
  attemptNumber     Int       @default(1)
  status            String    // INITIALIZED, PROCESSING, SUCCESS, FAILED, ABANDONED
  provider          String    @default("paystack")
  providerReference String?
  authorizationUrl  String?
  accessCode        String?
  requestPayload    Json?
  responsePayload   Json?
  errorMessage      String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  payment           Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([providerReference])
}

model PaymentWebhookEvent {
  id           String    @id @default(uuid())
  provider     String    // paystack
  eventId      String
  eventType    String
  payload      Json
  status       String    @default("PENDING") // PENDING, PROCESSED, IGNORED, FAILED
  signature    String?
  receivedAt   DateTime  @default(now())
  processedAt  DateTime?
  errorMessage String?

  @@unique([provider, eventId])
  @@index([status])
}

model PaymentRefund {
  id                String    @id @default(uuid())
  paymentId         String
  refundReference   String    @unique
  idempotencyKey    String    @unique
  amount            Int       // minor units (kobo)
  currency          String    @default("NGN")
  status            String    @default("PENDING") // PENDING, PROCESSING, SUCCESS, FAILED, CANCELLED
  reason            String?
  provider          String    @default("paystack")
  providerReference String?
  providerResponse  Json?
  requestedBy       String?
  createdAt         DateTime  @default(now())
  processedAt       DateTime?
  updatedAt         DateTime  @updatedAt

  payment           Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
}

model PaymentAuditEvent {
  id         String   @id @default(uuid())
  paymentId  String
  event      String
  actor      String?
  source     String?
  metadata   Json?    @default("{}")
  timestamp  DateTime @default(now())

  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model PaymentJob {
  id           String    @id @default(uuid())
  type         String    // FULFILLMENT, RECEIPT_EMAIL, RECONCILIATION
  payload      Json
  status       String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, DEAD_LETTER
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  lastError    String?
  runAt        DateTime  @default(now())
  processedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, runAt])
}

// ══════════════════════════════════════════════════════════════════════════════
// DOUBLE-ENTRY GENERAL LEDGER ACCOUNTING ARCHITECTURE
// ══════════════════════════════════════════════════════════════════════════════

model Account {
  id               String        @id @default(uuid())
  tenantId         String
  accountCode      String        // e.g. "1100", "2120", "4000"
  accountName      String
  classification   String        // ASSET, LIABILITY, EQUITY, REVENUE, COGS, EXPENSE, OTHER_INCOME, OTHER_EXPENSE
  accountType      String        // CURRENT_ASSET, FIXED_ASSET, FIXED_ASSET_CONTRA, CURRENT_LIABILITY, LONG_TERM_LIABILITY, EQUITY, REVENUE, COGS, ADMIN_EXPENSE, OTHER_REVENUE, OTHER_EXPENSE
  description      String?
  isSystemAccount  Boolean       @default(false)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalLines     JournalLine[]
  fixedAssets      FixedAsset[]
  bankAccounts     BankAccount[]

  @@unique([tenantId, accountCode])
  @@index([tenantId])
  @@index([tenantId, classification])
}

model JournalEntry {
  id             String        @id @default(uuid())
  tenantId       String
  entryNumber    String        // Sequential entry number e.g. "JE-2026-0001"
  entryDate      DateTime      // Accounting date
  memo           String?
  sourceType     String        // order_deposit, order_bake, order_delivery, purchase, expense, depreciation, prepayment_release, owner_capital, owner_loan, owner_draw, bank_transfer, reversal, manual, opening_balance
  sourceId       String?       // Reference ID of document that created this entry
  status         String        @default("POSTED") // POSTED, REVERSED
  reversalOfId   String?       @unique
  createdBy      String?
  createdAt      DateTime      @default(now())

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reversalOf     JournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy     JournalEntry? @relation("JournalReversal")
  lines          JournalLine[]

  @@index([tenantId])
  @@index([tenantId, entryDate])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, entryNumber])
}

model JournalLine {
  id             String       @id @default(uuid())
  tenantId       String
  journalEntryId String
  accountId      String
  debit          Decimal      @default(0) @db.Decimal(15, 2)
  credit         Decimal      @default(0) @db.Decimal(15, 2)
  description    String?

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, accountId])
  @@index([journalEntryId])
}

model BankAccount {
  id             String              @id @default(uuid())
  tenantId       String
  accountId      String              // Links to Account (e.g. 1110 Bank or 1100 Cash)
  accountName    String              // Friendly name e.g. "GTBank Main Bakery"
  bankName       String              // e.g. "Guaranty Trust Bank", "Access Bank", "Cash Drawer"
  accountNumber  String?
  currency       String              @default("NGN")
  isDefault      Boolean             @default(false)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account        Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  statementLines BankStatementLine[]

  @@index([tenantId])
  @@index([accountId])
}

model FixedAsset {
  id                    String              @id @default(uuid())
  tenantId              String
  assetAccountId        String              // References 1200, 1210, 1220, 1230, 1240, 1280
  name                  String              // e.g. "Industrial Spiral Dough Mixer 50kg"
  assetCategory         String              // bakery_equipment, motor_vehicles, furniture, computers, leasehold, intangibles
  acquisitionDate       DateTime
  cost                  Decimal             @db.Decimal(15, 2)
  residualValue         Decimal             @default(0) @db.Decimal(15, 2)
  usefulLifeMonths      Int                 @default(60) // Default 5 years (60 months)
  depreciationMethod    String              @default("STRAIGHT_LINE") // Straight line only
  useType               String              @default("production") // "production" (5060) or "office" (6400) or "intangible" (6410)
  accumulatedDepreciation Decimal           @default(0) @db.Decimal(15, 2)
  netBookValue          Decimal             @db.Decimal(15, 2)
  status                String              @default("ACTIVE") // ACTIVE, DISPOSED
  purchaseId            String?
  journalEntryId        String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetAccount          Account             @relation(fields: [assetAccountId], references: [id], onDelete: Restrict)
  depreciations         AssetDepreciation[]

  @@index([tenantId])
  @@index([assetAccountId])
  @@index([tenantId, status])
}

model AssetDepreciation {
  id             String       @id @default(uuid())
  tenantId       String
  fixedAssetId   String
  periodDate     DateTime     // Last day of depreciation month e.g. 2026-01-31
  amount         Decimal      @db.Decimal(15, 2)
  journalEntryId String?
  createdAt      DateTime     @default(now())

  fixedAsset     FixedAsset   @relation(fields: [fixedAssetId], references: [id], onDelete: Cascade)

  @@unique([fixedAssetId, periodDate])
  @@index([tenantId, periodDate])
}

model PrepaymentSchedule {
  id                 String               @id @default(uuid())
  tenantId           String
  description        String               // e.g. "Bakery Premises Annual Rent 2026-2027"
  totalAmount        Decimal              @db.Decimal(15, 2)
  assetAccountId     String               // References 1130 Other Receivable & Prepaid Expenses
  expenseAccountId   String               // Destination expense account (e.g. 5070 Production Rent or 6010 Rent)
  startDate          DateTime
  endDate            DateTime
  totalMonths        Int
  monthlyAmount      Decimal              @db.Decimal(15, 2)
  releasedAmount     Decimal              @default(0) @db.Decimal(15, 2)
  status             String               @default("ACTIVE") // ACTIVE, FULLY_AMORTIZED
  sourcePurchaseId   String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  releases           PrepaymentRelease[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model PrepaymentRelease {
  id             String             @id @default(uuid())
  scheduleId     String
  periodDate     DateTime           // e.g. 2026-02-28
  amount         Decimal            @db.Decimal(15, 2)
  journalEntryId String?
  createdAt      DateTime           @default(now())

  schedule       PrepaymentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
}

model BankStatementLine {
  id                   String       @id @default(uuid())
  tenantId             String
  bankAccountId        String
  lineDate             DateTime
  description          String
  amount               Decimal      @db.Decimal(15, 2)
  lineType             String       // "credit" or "debit"
  status               String       @default("UNMATCHED") // UNMATCHED, MATCH_SUGGESTED, MATCHED, JOURNAL_CREATED
  matchedJournalEntryId String?
  suggestedAccountId   String?
  reference            String?
  rawMetadata          Json?        @default("{}")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  tenant               Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bankAccount          BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, bankAccountId, status])
}

model AccountingPeriod {
  id             String       @id @default(uuid())
  tenantId       String
  periodKey      String       // Format: "YYYY-MM" e.g. "2026-01"
  startDate      DateTime
  endDate        DateTime
  isLocked       Boolean      @default(false)
  lockedAt       DateTime?
  lockedBy       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodKey])
  @@index([tenantId])
}


